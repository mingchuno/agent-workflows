{
  "name": "@mingchuno/agent-workflows-core",
  "version": "0.12.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingchuno/agent-workflows.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "Durable coding workflow runtime and SDK on DBOS",
  "files": [
