      "types": "./dist/src/operator/index.d.ts",
      "import": "./dist/src/operator/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-migrations.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.0.2",
    "@gitbeaker/rest": "^43.8.0",
    "@github/copilot-sdk": "^1.0.15",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "^0.155.1",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
