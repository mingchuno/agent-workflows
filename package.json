{
  "name": "agent-workflows-workspace",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-workspace.mjs && node scripts/clean-build.mjs && pnpm --filter @mingchuno/agent-workflows-core build && pnpm --filter @mingchuno/agent-workflows build",
    "web:dev": "pnpm --filter @mingchuno/agent-workflows-core build && node --import tsx tests/web-demo.ts",
    "web:test": "pnpm --filter @mingchuno/agent-workflows-core build && node --import tsx --test tests/web-demo.test.ts",
    "web:build": "pnpm --filter @mingchuno/agent-workflows web:build",
    "check": "node scripts/check-workspace.mjs && pnpm --filter @mingchuno/agent-workflows-core build && tsc --noEmit && pnpm --filter @mingchuno/agent-workflows-core check && pnpm --filter @mingchuno/agent-workflows check",
    "test": "pnpm build && node --test scripts/*.test.mjs && node scripts/test.mjs",
    "verify": "pnpm check && pnpm lint && pnpm test",
    "pack:smoke": "pnpm build && node scripts/test.mjs --pack-smoke",
    "release:publish": "node scripts/publish.mjs",
    "lint:pr": "node scripts/lint-pr-title.mjs",
    "start": "pnpm --filter @mingchuno/agent-workflows-core build && node --import tsx -- packages/cli/src/cli.ts",
    "tui:preview": "pnpm --filter @mingchuno/agent-workflows-core build && node --import tsx -- tests/tui-demo.tsx",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/core/src/db/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.10",
    "ink-testing-library": "^4.0.0",
    "npm": "12.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@dbos-inc/dbos-sdk": "^5.0.2",
    "@github/copilot-sdk": "^1.0.15",
    "@openai/codex-sdk": "^0.155.1",
    "ink": "^7.1.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "zod": "^4.6.5",
    "string-width": "^8.2.2",
    "@types/pg": "^8.23.1"
  },
  "packageManager": "pnpm@12.4.2"
}
