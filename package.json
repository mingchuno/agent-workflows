{
  "name": "agent-workflows",
  "version": "0.1.0",
  "description": "Local durable coding workflows on DBOS",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "agent-workflows": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "check": "tsc --noEmit",
    "test": "pnpm build && node scripts/test.mjs",
    "start": "tsx src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.0.2",
    "@gitbeaker/rest": "^43.8.0",
    "@github/copilot-sdk": "^1.0.14",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "^0.155.1",
    "commander": "^15.0.0",
    "drizzle-orm": "0.45.2",
    "ink": "^7.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "drizzle-kit": "0.31.10",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
