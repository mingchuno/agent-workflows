  "narrative": {
    "northStar": "Evidence leads decisions",
    "overview": "The browser monitor is a light operator console: deep blue project navigation,\na compact Run list, and a white workspace for recorded evidence. Technical report\ntypography and pale supporting surfaces keep inspection clear without turning\nworkflow state into decorative summary tiles.\n\nThis browser system is additive. The tokens above apply to the browser surface,\nnot terminal rendering. The incumbent terminal guidance is preserved verbatim at\nthe end of this file; the TUI retains the terminal's own font and colors.",
    "keyCharacteristics": [
      "Stable selection and explicit attention states.",
      "Compact navigation beside spacious evidence.",
      "System controls, report headings, and monospace technical evidence."
    ],
    "rules": [
      {
        "name": "The Evidence Priority Rule",
        "body": "Explain the selected subject and need for intervention before technical detail.",
        "section": "layout"
      },
      {
        "name": "The State Plus Text Rule",
        "body": "Use outcome labels and explanatory text alongside semantic color.",
        "section": "colors"
      },
      {
        "name": "The Three Type Roles Rule",
        "body": "Use Source Sans 3 for h1\u2013h3, system sans for body and controls, and monospace for code and preformatted evidence.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use surface color and thin dividers for everyday structure; reserve the shipped shadow and backdrop for confirmation dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve selected Run identity while polling and filtering.",
      "Do show stale evidence and command acknowledgement as explicit text.",
      "Do retain native controls, visible keyboard focus, and confirmation with Cancel focused.",
      "Do keep absent evidence distinct from success and readiness distinct from delivery.",
      "Do preserve the terminal system when extending the browser monitor."
    ],
    "donts": [
      "Don't substitute summary tiles for recorded evidence.",
      "Don't use semantic color without its outcome or attention label.",
      "Don't hide required diagnostics behind truncated display text.",
      "Don't treat closing either monitor as a command to stop workflows."
    ]
  }
}
