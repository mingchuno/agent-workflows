{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "react"],
    "paths": { "@mingchuno/agent-workflows": ["./src/index.ts"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "include": [
    "drizzle.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
