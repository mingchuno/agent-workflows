{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "react"],
    "paths": {
      "@mingchuno/agent-workflows-core": ["./packages/core/src/index.ts"],
      "@mingchuno/agent-workflows-core/operator": [
        "./packages/core/src/operator/index.ts"
      ]
    }
  },
  "include": [
    "drizzle.config.ts",
